# ---------------------------------------------------------------------------
# Model provider. Selected at runtime; no provider is hardcoded anywhere in the
# source. Valid values: bedrock, gemini, anthropic, ollama
# ---------------------------------------------------------------------------
VAYUDOOT_MODEL_PROVIDER=bedrock
VAYUDOOT_MODEL_ID=
VAYUDOOT_MODEL_TEMPERATURE=0.2

# Amazon Bedrock (used when VAYUDOOT_MODEL_PROVIDER=bedrock)
AWS_REGION=us-west-2

# Google Gemini (used when VAYUDOOT_MODEL_PROVIDER=gemini)
GEMINI_API_KEY=

# Anthropic direct (used when VAYUDOOT_MODEL_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Evidence data sources
# ---------------------------------------------------------------------------
# NASA FIRMS map key: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
# OpenAQ v3 API key: https://explore.openaq.org/register
OPENAQ_API_KEY=

# ---------------------------------------------------------------------------
# Filing safety. Live filing sends complaints to real regulators and is OFF by
# default. Leave this false unless you know exactly what you are doing.
# ---------------------------------------------------------------------------
VAYUDOOT_LIVE_FILING=false
VAYUDOOT_SANDBOX_OUTBOX=./outbox
