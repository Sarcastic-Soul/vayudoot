# ---------------------------------------------------------------------------
# Model provider. Selected at runtime; no provider is hardcoded anywhere in the
# source. Valid values: gemini, ollama
# ---------------------------------------------------------------------------
VAYUDOOT_MODEL_PROVIDER=ollama
# The fast tier can run on a different provider. A report makes two primary
# calls (evidence, drafting) and about eight fast ones, so splitting them puts
# the volume on whichever free tier has the request allowance and the judgement
# on whichever has the better model. Leave empty to use one provider for both.
VAYUDOOT_MODEL_PROVIDER_FAST=gemini
# Leave both model IDs empty to use the per-provider defaults in config.py.
# VAYUDOOT_MODEL_ID is the primary tier: reading photographs, drafting complaints.
# VAYUDOOT_MODEL_ID_FAST is the cheap tier: agents that call one tool and summarise.
VAYUDOOT_MODEL_ID=
VAYUDOOT_MODEL_ID_FAST=
VAYUDOOT_MODEL_TEMPERATURE=0.2

# Google Gemini (used when VAYUDOOT_MODEL_PROVIDER=gemini)
GEMINI_API_KEY=

# Ollama (used when VAYUDOOT_MODEL_PROVIDER=ollama). The same provider serves a
# local daemon and Ollama Cloud. Local needs no key:
#   OLLAMA_HOST=http://localhost:11434
# Ollama Cloud needs a key from https://ollama.com/settings/keys, and its free
# tier is the only way to run this without local GPU:
#   OLLAMA_HOST=https://ollama.com
# The default model ids are the cloud ones. gemma4:31b is the multimodal model
# the evidence stage needs; running locally means overriding both ids.
OLLAMA_HOST=https://ollama.com
OLLAMA_API_KEY=

# Ollama Cloud's free tier publishes no request count, only a session
# percentage (resets every 4 hours) and a weekly one (resets every 5 days), so
# there is nothing exact to enforce. These two caps are a safety backstop
# against a retry loop or scheduler bug quietly burning that budget, not a copy
# of Ollama's own limit — defaults are generous enough that normal use and the
# test suite never reach them. Local Ollama (OLLAMA_HOST=http://localhost:...)
# is never throttled by this; it has no cloud quota to protect.
VAYUDOOT_OLLAMA_SESSION_CALL_LIMIT=200
VAYUDOOT_OLLAMA_SESSION_WINDOW_HOURS=4
VAYUDOOT_OLLAMA_WEEKLY_CALL_LIMIT=1000
VAYUDOOT_OLLAMA_WEEKLY_WINDOW_DAYS=5

# ---------------------------------------------------------------------------
# Evidence data sources
# ---------------------------------------------------------------------------
# NASA FIRMS map key: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
# OpenAQ v3 API key: https://explore.openaq.org/register
OPENAQ_API_KEY=

# ---------------------------------------------------------------------------
# Filing safety. Live filing sends complaints to real regulators and is OFF by
# default. Leave this false unless you know exactly what you are doing.
# ---------------------------------------------------------------------------
VAYUDOOT_LIVE_FILING=false
VAYUDOOT_SANDBOX_OUTBOX=./outbox

# Uploaded photographs and persisted cases. Only used when DATABASE_URL below
# is empty; on a free container this directory is ephemeral, so a demo is fine
# with it but a public deployment should set DATABASE_URL instead.
VAYUDOOT_CASE_DIR=./data/cases
VAYUDOOT_UPLOAD_DIR=./data/uploads

# A Postgres connection string (Neon, Supabase, or any other host — plain SQL,
# nothing provider-specific). Leave empty to keep cases as JSON files under
# VAYUDOOT_CASE_DIR above; set it to survive a container restart or redeploy.
# See store.py.
DATABASE_URL=

# ---------------------------------------------------------------------------
# Intake limits. One report is about ten model calls against a free-tier daily
# allowance, so an open form on a public URL is an open tap: one crawler can
# empty the day's budget before a citizen reaches it. Both counters live in the
# process and reset when it restarts, which is fine for a single-process
# prototype. Set either cap to 0 to close intake entirely.
# ---------------------------------------------------------------------------
VAYUDOOT_RATE_LIMIT=true
# Reports one visitor may submit inside the window below.
VAYUDOOT_REPORTS_PER_CLIENT=5
VAYUDOOT_RATE_LIMIT_WINDOW_SECONDS=3600
# Reports the whole instance accepts in one UTC day. This is the budget line.
VAYUDOOT_REPORTS_PER_DAY=60
# Largest photograph accepted, in bytes. Phone JPEGs are 2-6 MB, and the image
# is scaled to 1568px before a model sees it, so a large upload buys nothing.
VAYUDOOT_MAX_UPLOAD_BYTES=12582912
