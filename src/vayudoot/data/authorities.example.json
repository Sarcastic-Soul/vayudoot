{
  "_comment": [
    "Jurisdiction table. Authority NAMES are real and public; every EMAIL here is a",
    "non-routable placeholder on the reserved .invalid TLD, deliberately, so that a",
    "misconfigured run cannot reach a real regulator. Real contact addresses belong in",
    "authorities.json, which overrides this file and is not committed.",
    "Keys are lowercased state and city names as returned by reverse geocoding.",
    "Coverage is every one of India's 28 states and 8 union territories, each with its",
    "pollution control board or committee, its one to three largest municipal bodies,",
    "and the Central Pollution Control Board as the escalation body. A few keys are",
    "aliases for a region a geocoder may still name the old way, so the key count is",
    "higher than the region count.",
    "A state absent from this table still resolves, via default_state, to a generic",
    "state board entry rather than failing."
  ],
  "categories": {
    "open_waste_burning": {
      "tier": "municipal",
      "statute": "Solid Waste Management Rules, 2016",
      "section": "Rule 15, duties of local authorities",
      "response_window_days": 15
    },
    "crop_residue_burning": {
      "tier": "state",
      "statute": "Air (Prevention and Control of Pollution) Act, 1981",
      "section": "Section 19, restrictions on emissions in an air pollution control area",
      "response_window_days": 15
    },
    "industrial_emission": {
      "tier": "state",
      "statute": "Air (Prevention and Control of Pollution) Act, 1981",
      "section": "Section 31A, power to issue directions",
      "response_window_days": 30
    },
    "construction_dust": {
      "tier": "municipal",
      "statute": "Construction and Demolition Waste Management Rules, 2016",
      "section": "Rule 4, duties of the waste generator",
      "response_window_days": 15
    },
    "vehicle_emission": {
      "tier": "state",
      "statute": "Air (Prevention and Control of Pollution) Act, 1981",
